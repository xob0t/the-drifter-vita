+        // One output register can pack several semantics (e.g. o1.xy = TEXCOORD0, o1.zw =
+        // TEXCOORD1). A write covering more than one of them is split into one instruction
+        // per semantic; otherwise only the last semantic would receive the value.
+        private static void SplitPackedOutputWrites(UShaderProgram shader)
+        {
+            List<USILInstruction> instructions = shader.instructions;
+            for (int n = 0; n < instructions.Count; n++)
+            {
+                USILInstruction instruction = instructions[n];
+                USILOperand? dest = instruction.destOperand;
+                if (dest == null || dest.operandType != USILOperandType.OutputRegister || dest.mask.Length < 2)
+                {
+                    continue;
+                }
+
+                List<USILInputOutput> outputs = shader.outputs.Where(
+                    o => o.register == dest.registerIndex && dest.mask.Any(m => (o.mask & (1 << m)) != 0)
+                ).ToList();
+                if (outputs.Count < 2)
+                {
+                    continue;
+                }
+
+                List<USILInstruction> parts = new List<USILInstruction>();
+                bool componentWise = true;
+                foreach (USILInputOutput output in outputs)
+                {
+                    int[] positions = Enumerable.Range(0, dest.mask.Length)
+                        .Where(p => (output.mask & (1 << dest.mask[p])) != 0).ToArray();
+                    USILInstruction part = new USILInstruction
+                    {
+                        instructionType = instruction.instructionType,
+                        saturate = instruction.saturate,
+                        commented = instruction.commented,
+                        isIntVariant = instruction.isIntVariant,
+                        isIntUnsigned = instruction.isIntUnsigned,
+                        destOperand = new USILOperand(dest) { mask = positions.Select(p => dest.mask[p]).ToArray() },
+                    };
+                    foreach (USILOperand source in instruction.srcOperands)
+                    {
+                        USILOperand copy = new USILOperand(source);
+                        if (source.immValueFloat.Length == dest.mask.Length)
+                        {
+                            copy.immValueFloat = positions.Select(p => source.immValueFloat[p]).ToArray();
+                        }
+                        if (source.immValueInt.Length == dest.mask.Length)
+                        {
+                            copy.immValueInt = positions.Select(p => source.immValueInt[p]).ToArray();
+                        }
+                        if (source.mask.Length == dest.mask.Length)
+                        {
+                            copy.mask = positions.Select(p => source.mask[p]).ToArray();
+                        }
+                        else if (source.mask.Length > 1)
+                        {
+                            componentWise = false;
+                        }
+                        part.srcOperands.Add(copy);
+                    }
+                    parts.Add(part);
+                }
+
+                if (!componentWise)
+                {
+                    continue;
+                }
+                instructions.RemoveAt(n);
+                instructions.InsertRange(n, parts);
+                n += parts.Count - 1;
+            }
+        }
+
